   "source": [
    "def sortColors(colorStr):\n",
    "    colors = colorStr.split('-')\n",
    "    return '-'.join(sorted(colors))\n",
    "\n",
    "colors = 'PINK-BLUE-TAN-PURPLE'\n",
    "print(sortColors(colors))"
   ]
  }
